# =============================================================================
# BLOOD DONATION CAMP - ENVIRONMENT CONFIGURATION (GOOGLE SHEETS)
# =============================================================================

# --- Google Sheets & Google Apps Script Integration ---
# 1. Deploy the provided `google-apps-script.js` as a Web App in Google Sheets.
# 2. Paste the Web App URL below:
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/YOUR_GOOGLE_APPS_SCRIPT_DEPLOYMENT_URL/exec"

# 3. Optional shared secret matching INTEGRATION_SECRET in google-apps-script.js
APPS_SCRIPT_SECRET="blood_camp_secret_2026"

# --- Camp Public URLs (Used for QR Code Generation) ---
# When deployed on Vercel, change to your production domain:
# e.g., https://blood-camp-jodhpur.vercel.app/
NEXT_PUBLIC_REGISTRATION_URL="http://localhost:3000/#register-section"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Camp Event Details (Configurable) ---
NEXT_PUBLIC_CAMP_NAME="रक्तदान शिविर"
NEXT_PUBLIC_CAMP_DATE="18 October 2026, Sunday"
NEXT_PUBLIC_CAMP_DATE_HINDI="18 अक्टूबर 2026, रविवार"
NEXT_PUBLIC_CAMP_TIME="9:00 AM – 5:00 PM"
NEXT_PUBLIC_CAMP_VENUE="Shri Jai Narayan Vyas Vidyalaya, Jadav Mohalla, Jodhpur, Rajasthan"
NEXT_PUBLIC_CAMP_VENUE_HINDI="श्री जय नारायण व्यास विद्यालय, जादव मोहल्ला, जोधपुर"
NEXT_PUBLIC_CAMP_MAP_URL="https://maps.google.com/?q=Shri+Jai+Narayan+Vyas+Vidyalaya+Jodhpur"

# --- Admin Portal (Optional) ---
AUTH_SECRET="f6c8d7e9a1b2c3d4e5f60718293a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_SEED_EMAIL="admin@blooddonate.local"
ADMIN_SEED_PASSWORD="ChangeThisPassword@123"

# --- Environment ---
NODE_ENV="development"
